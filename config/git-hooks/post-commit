#!/bin/bash

# Post-commit hook for automatic AvesAID versioning
# This hook will automatically create tags in format: v{upstream_version}-{avesaid_major}.{avesaid_minor}.{avesaid_patch}
# Example: v1.15.4-1.2.3

set -euo pipefail

# Configuration
VERSION_PREFIX="v"
BRANCH_NAME=$(git branch --show-current)
# Auto-version on all branches EXCEPT main (main is for stable releases only)
EXCLUDED_BRANCHES=("main")

# Ensure proper Git configuration for merge behavior and tag handling
configure_git_settings() {
    log_info "Configuring Git settings for merge behavior and tag handling..."
    
    # Force fast-forward only merges to prevent unwanted merge commits
    git config merge.ff only
    
    # Automatically push tags along with commits
    git config push.followTags true
    
    # Automatically fetch all tags when pulling/fetching
    git config remote.origin.tagopt --tags
    
    log_success "Git configuration updated successfully"
}

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() {
    echo -e "${BLUE}[AUTO-VERSION]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[AUTO-VERSION]${NC} $1"
}

log_error() {
    echo -e "${RED}[AUTO-VERSION]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[AUTO-VERSION]${NC} $1"
}

# Check if we should auto-tag this branch (all branches except main)
should_auto_tag() {
    # Check if current branch is in excluded list
    for excluded in "${EXCLUDED_BRANCHES[@]}"; do
        if [[ "$BRANCH_NAME" == $excluded ]]; then
            return 1  # Don't auto-tag excluded branches
        fi
    done
    return 0  # Auto-tag all other branches
}

# Get the current upstream version that this branch is based on
get_current_upstream_version() {
    # First try to find the upstream tag that contains the current commit
    local current_commit=$(git rev-parse HEAD)

    # Look for upstream tags that are ancestors of current commit
    local upstream_tags=$(git tag --list | grep -E "^${VERSION_PREFIX}[0-9]+\.[0-9]+\.[0-9]+$" | sort -V -r)

    for tag in $upstream_tags; do
        # Check if this tag is an ancestor of current commit
        if git merge-base --is-ancestor "$tag" "$current_commit" 2>/dev/null; then
            echo "$tag"
            return 0
        fi
    done

    # Fallback: check if we already have AvesAID tags to infer the base version
    local latest_avesaid=$(git tag --sort=-version:refname | grep -E "^${VERSION_PREFIX}[0-9]+\.[0-9]+\.[0-9]+-[0-9]+\.[0-9]+\.[0-9]+$" | head -n1)
    if [[ -n "$latest_avesaid" ]]; then
        # Extract the upstream part from existing AvesAID tag
        if [[ $latest_avesaid =~ ^(${VERSION_PREFIX}[0-9]+\.[0-9]+\.[0-9]+)- ]]; then
            echo "${BASH_REMATCH[1]}"
            return 0
        fi
    fi

    # Final fallback: get the latest upstream version
    git tag --sort=-version:refname | grep -E "^${VERSION_PREFIX}[0-9]+\.[0-9]+\.[0-9]+$" | head -n1 || echo ""
}

# Get the latest AvesAID version tag with current upstream base
get_latest_avesaid_version() {
    local upstream_base=$1
    # Look for tags like v1.15.4-1.2.3 with the same upstream base
    git tag --sort=-version:refname | grep -E "^${upstream_base}-[0-9]+\.[0-9]+\.[0-9]+$" | head -n1 || echo ""
}

# Parse AvesAID version (v1.15.4-1.2.3 format)
parse_avesaid_version() {
    local version=$1
    if [[ $version =~ ^${VERSION_PREFIX}([0-9]+\.[0-9]+\.[0-9]+)-([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
        upstream_version=${BASH_REMATCH[1]}
        avesaid_major=${BASH_REMATCH[2]}
        avesaid_minor=${BASH_REMATCH[3]}
        avesaid_patch=${BASH_REMATCH[4]}
        return 0
    else
        upstream_version=""
        avesaid_major=1
        avesaid_minor=0
        avesaid_patch=0
        return 1
    fi
}

# Increment AvesAID version based on commit message
increment_avesaid_version() {
    local commit_msg=$(git log -1 --pretty=format:"%s")

    # Check commit message for version increment hints
    if [[ $commit_msg =~ \[major\]|\[MAJOR\]|BREAKING[[:space:]]CHANGE|^MAJOR|MAJOR: ]]; then
        avesaid_major=$((avesaid_major + 1))
        avesaid_minor=0
        avesaid_patch=0
        log_info "AvesAID major version increment detected: $commit_msg"
    elif [[ $commit_msg =~ \[minor\]|\[MINOR\]|feat:|feature:|^MINOR|MINOR: ]]; then
        avesaid_minor=$((avesaid_minor + 1))
        avesaid_patch=0
        log_info "AvesAID minor version increment detected: $commit_msg"
    else
        avesaid_patch=$((avesaid_patch + 1))
        log_info "AvesAID patch version increment: $commit_msg"
    fi
}

# Main execution
main() {
    # Configure Git settings first
    configure_git_settings
    
    # Check if this is a merge commit (skip auto-versioning for merge commits)
    if git log -1 --pretty=format:"%P" | grep -q " "; then
        log_info "Merge commit detected, skipping auto-versioning"
        exit 0
    fi

    # Check if we should auto-tag this branch
    if ! should_auto_tag; then
        log_info "Branch '$BRANCH_NAME' is excluded from auto-versioning (reserved for stable releases)"
        exit 0
    fi

    log_info "Auto-versioning commit on branch: $BRANCH_NAME"

    # Get current upstream version that this branch is based on
    upstream_base_version=$(get_current_upstream_version)
    if [[ -z "$upstream_base_version" ]]; then
        log_error "No upstream version tag found that contains the current commit"
        log_error "Please ensure the current branch is based on an upstream tag like v1.15.4"
        exit 1
    fi

    # Remove the 'v' prefix for processing
    upstream_version_number=${upstream_base_version#$VERSION_PREFIX}
    log_info "Current code is based on upstream version: $upstream_base_version"

    # Get latest AvesAID version for this upstream base
    latest_avesaid_version=$(get_latest_avesaid_version "$upstream_base_version")

    if [[ -z "$latest_avesaid_version" ]]; then
        log_warn "No existing AvesAID version for base $upstream_base_version, starting with 1.0.0"
        avesaid_major=1
        avesaid_minor=0
        avesaid_patch=0
    else
        log_info "Latest AvesAID version: $latest_avesaid_version"

        # Parse current AvesAID version
        if parse_avesaid_version "$latest_avesaid_version"; then
            log_info "Parsed AvesAID version: major=$avesaid_major, minor=$avesaid_minor, patch=$avesaid_patch"
        else
            log_warn "Failed to parse AvesAID version, starting fresh with 1.0.0"
            avesaid_major=1
            avesaid_minor=0
            avesaid_patch=0
        fi
    fi

    # Increment AvesAID version
    increment_avesaid_version

    # Create new version tag
    new_version="${upstream_base_version}-${avesaid_major}.${avesaid_minor}.${avesaid_patch}"

    # Check if tag already exists
    if git tag | grep -q "^${new_version}$"; then
        log_warn "Tag $new_version already exists, skipping"
        exit 0
    fi

    # Create the tag
    commit_hash=$(git rev-parse HEAD)
    commit_msg=$(git log -1 --pretty=format:"%s")

    tag_message="AvesAID version $new_version

Upstream Base: $upstream_base_version
AvesAID Version: ${avesaid_major}.${avesaid_minor}.${avesaid_patch}
Commit: $commit_hash
Message: $commit_msg
Branch: $BRANCH_NAME
Date: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"

    if git tag -a "$new_version" -m "$tag_message"; then
        log_success "Created AvesAID tag: $new_version"

        # Optional: Push tag to remote (uncomment if desired)
        # if git push origin "$new_version" 2>/dev/null; then
        #     log_success "Pushed tag $new_version to origin"
        # else
        #     log_warn "Failed to push tag $new_version to origin"
        # fi
    else
        log_error "Failed to create tag: $new_version"
        exit 1
    fi
}

# Run main function
main "$@"
